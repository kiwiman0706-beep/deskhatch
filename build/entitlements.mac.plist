<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- Electron runs a JIT (V8) and maps writable-executable pages; the hardened
       runtime kills the process without these. -->
  <key>com.apple.security.cs.allow-jit</key>
  <true/>
  <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
  <true/>
  <key>com.apple.security.cs.allow-dyld-environment-variables</key>
  <true/>
  <!-- koffi (src/main/system.js) dlopen()s ApplicationServices for CGEventPost,
       and ffmpeg-static ships as a separate binary under app.asar.unpacked. -->
  <key>com.apple.security.cs.disable-library-validation</key>
  <true/>
  <!-- "Exit full screen" synthesises key events / talks to other apps. -->
  <key>com.apple.security.automation.apple-events</key>
  <true/>
</dict>
</plist>
