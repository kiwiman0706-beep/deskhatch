{
  "name": "deskhatch",
  "version": "0.1.71-beta.1",
  "description": "DeskHatch — a SmartCenter-style top-edge drawer launcher (Electron). A thin bar docks at the top of the screen; clicking a button slides a drawer down directly beneath it.",
  "main": "src/main/main.js",
  "author": "DeskHatch",
  "scripts": {
    "start": "electron .",
    "selftest": "electron . --selftest",
    "gen:icons": "node scripts/generate-icons.js",
    "gen:appx": "node scripts/gen-appx-assets.js",
    "diagnose:open": "node scripts/diagnose-open.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "pack": "electron-builder --win --dir",
    "dist": "electron-builder --win",
    "dist:mac": "electron-builder --mac",
    "dist:linux": "electron-builder --linux",
    "dist:msix": "electron-builder --win appx"
  },
  "license": "MIT",
  "dependencies": {
    "electron-updater": "^6.3.9",
    "ffmpeg-static": "^5.2.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.47.0",
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3",
    "sharp": "^0.33.5",
    "vitest": "^2.0.0"
  },
  "optionalDependencies": {
    "koffi": "^2.9.0"
  },
  "build": {
    "appId": "com.deskhatch.app",
    "productName": "DeskHatch",
    "artifactName": "${productName}-${version}-${arch}.${ext}",
    "publish": {
      "provider": "github",
      "owner": "kiwiman0706-beep",
      "repo": "deskhatch"
    },
    "generateUpdatesFilesForAllChannels": true,
    "files": [
      "src/**/*",
      "assets/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "**/node_modules/ffmpeg-static/**",
      "**/node_modules/koffi/**"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "assets/icon.png",
      "publisherName": "DeskHatch",
      "verifyUpdateCodeSignature": false
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.productivity",
      "icon": "assets/icon.png",
      "hardenedRuntime": true
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Utility",
      "icon": "assets/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "DeskHatch",
      "artifactName": "${productName}-Setup-${version}-${arch}.${ext}"
    },
    "portable": {
      "artifactName": "${productName}-Portable-${version}-${arch}.${ext}"
    },
    "appx": {
      "identityName": "ThetaCorp.DeskHatch",
      "publisher": "CN=A0CA65A9-A5EE-4D00-9CF0-76817AA1C10F",
      "publisherDisplayName": "Theta Corp",
      "applicationId": "DeskHatch",
      "backgroundColor": "#1f7f7f",
      "showNameOnTiles": true,
      "languages": ["en-US", "ja-JP"]
    }
  }
}
